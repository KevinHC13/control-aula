# Copiar a .env y rellenar con los datos del proyecto de Supabase.
# Ambas son públicas por diseño: viajan en el bundle del front.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# GEMINI_API_KEY no va aquí: es secret de la Edge Function `extraer-lista`
# (`npx supabase secrets set GEMINI_API_KEY=...`). La clave de Gemini nunca
# llega al navegador.
